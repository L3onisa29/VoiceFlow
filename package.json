{
  "name": "voiceflow",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "desktop:build": "node scripts/build-desktop.ts",
    "desktop:check": "pnpm --filter @voiceflow/desktop check",
    "desktop:ui": "pnpm --filter @voiceflow/desktop build",
    "desktop:verify-runtime": "node scripts/verify-desktop-runtime.ts",
    "test:desktop-runtime": "node --test scripts/desktop-runtime.test.ts",
    "doctor": "node scripts/doctor.ts",
    "model:download": "node scripts/download-model.ts",
    "test:rust": "cargo test --workspace --locked",
    "test:streaming": "cargo build --release --locked -p voiceflow-core --bin streaming-benchmark && node scripts/verify-streaming.ts",
    "test:short-recordings": "cargo build --release --locked -p voiceflow-core --bin streaming-benchmark && node scripts/verify-short-recordings.ts",
    "test:signing": "node --test scripts/build-signing.test.ts",
    "test:errors": "node --test scripts/errors.test.ts",
    "test:ui": "node scripts/verify-ui.ts",
    "test:native-helper": "cargo build --release --locked -p voiceflow-desktop --bin voiceflow-analysis && node scripts/verify-native-helper.ts",
    "test:state": "node scripts/verify-state-renders.ts",
    "voice-profile:eval": "cargo run --release --locked -p voiceflow-desktop --bin voice-profile-eval --",
    "test:corrections": "node --test scripts/corrections.test.ts"
  },
  "type": "module",
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "^3.9.9"
  }
}
