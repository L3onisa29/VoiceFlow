{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voiceflow:analysis-output:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "anyOf": [
              {
                "$ref": "#/$defs/candidate"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "action": {
            "enum": [
              "keep",
              "remove",
              "replace"
            ],
            "type": "string"
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "candidate",
          "evidence",
          "name",
          "text",
          "reason",
          "action",
          "confidence"
        ]
      }
    },
    "misspellings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/misspelling"
      }
    }
  },
  "required": [
    "candidates",
    "misspellings"
  ],
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "exceptBefore": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 32
        },
        "exceptAfter": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "before",
        "after",
        "exceptBefore",
        "exceptAfter"
      ]
    },
    "operation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "remove-false-start",
              "type": "string"
            },
            "source": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minItems": 2,
              "maxItems": 7
            }
          },
          "required": [
            "kind",
            "source"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "repeat",
              "type": "string"
            },
            "word": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "kind",
            "word"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "elision",
              "type": "string"
            },
            "first": {
              "const": "della",
              "type": "string"
            },
            "prefix": {
              "enum": [
                "dell'",
                "dell’"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind",
            "first",
            "prefix"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "phrase"
          ],
          "properties": {
            "kind": {
              "const": "repeat-phrase",
              "type": "string"
            },
            "phrase": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        }
      ]
    },
    "definition": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": {
              "const": "terminology",
              "type": "string"
            },
            "preferred": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "variants": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 1,
              "maxItems": 32
            },
            "matching": {
              "enum": [
                "exact",
                "unicode-lowercase"
              ],
              "type": "string"
            },
            "context": {
              "$ref": "#/$defs/context"
            }
          },
          "required": [
            "category",
            "preferred",
            "variants",
            "matching",
            "context"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "category": {
              "const": "cleanup",
              "type": "string"
            },
            "operation": {
              "$ref": "#/$defs/operation"
            },
            "context": {
              "$ref": "#/$defs/context"
            }
          },
          "required": [
            "category",
            "operation",
            "context"
          ]
        }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "language": {
          "enum": [
            "*",
            "it",
            "en"
          ],
          "type": "string"
        },
        "groupIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 0,
          "maxItems": 32
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "positiveExamples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "negativeExamples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "definition",
        "language",
        "groupIds",
        "reason",
        "positiveExamples",
        "negativeExamples"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revisionId": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "originalIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sessionId",
        "revisionId",
        "originalIndex"
      ]
    },
    "misspelling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "intended": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "realWord": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "intended",
        "evidence",
        "confidence",
        "realWord"
      ]
    }
  }
}
