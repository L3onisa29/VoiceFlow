{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "backtrack",
              "remove_filler",
              "remove_repetition",
              "punctuation",
              "grammar"
            ]
          },
          "source": {"type": "string"},
          "replacement": {"type": "string"}
        },
        "required": ["type", "source", "replacement"]
      }
    }
  },
  "required": ["text", "operations"]
}
