{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {"type": "string"},
          "source": {"type": "string"},
          "replacement": {"type": "string"}
        },
        "required": ["type", "source", "replacement"]
      }
    }
  },
  "required": ["text", "operations"]
}
